# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
# Comma-separated list of allowed origins for the frontend (GB). Use "*" only
# for quick local testing without credentials; the SPA sends credentials, so
# set an explicit origin in every real environment.
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=golden_bites
DB_USER=fabianmartinezhoyos
DB_PASSWORD=
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_SSL=false

# JWT (generate strong random secrets for real environments)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Fixed business/branch the public, unauthenticated Car Service kiosk
# endpoints operate on (see src/modules/tablet-kiosk) — there is no JWT on
# those requests to read a businessId from, so this single-tenant
# deployment fixes both here. Find yours with:
# SELECT id FROM businesses; / SELECT id FROM branches;
CAR_SERVICE_BUSINESS_ID=
CAR_SERVICE_BRANCH_ID=

# Bancolombia bank-transfer verification (off by default — see
# GB-BE/docs/bank-verification.md for full setup instructions).
# BANK_VERIFICATION_ENABLED=false hides the whole feature (routes 404, no
# background ingestion, cashier button hidden) regardless of the rest below.
BANK_VERIFICATION_ENABLED=false
# "mock" (dev only, simulate transfers via POST /dev/bank-transactions/simulate)
# or "gmail" (reads real Bancolombia notification emails). The app refuses to
# start with "mock" when NODE_ENV=production.
BANK_VERIFICATION_PROVIDER=mock
# The one business whose orders get matched against incoming transactions —
# a mailbox belongs to one bank account, which belongs to one business.
# Find yours with: SELECT id, name FROM businesses;
BANK_VERIFICATION_BUSINESS_ID=
BANK_VERIFICATION_POLL_INTERVAL_MS=30000
BANK_VERIFICATION_MATCH_WINDOW_MINUTES=120
BANK_VERIFICATION_MATCH_BACKWARD_TOLERANCE_MINUTES=5
# Comma-separated list of the exact From addresses to trust (never just the
# display name). Leave empty only for local testing with the mock provider.
BANK_EMAIL_SENDER_ALLOWLIST=
# Optional substring the email subject must contain, e.g. "Comprobante de transferencia".
BANK_EMAIL_SUBJECT_FILTER=

# Gmail OAuth 2.0 (offline refresh token — no password is ever stored).
# Obtain these by running `npm run gmail:authorize` — see
# GB-BE/docs/bank-verification.md.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
GMAIL_OAUTH_REDIRECT_URI=http://localhost:3000/oauth2callback
