# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
# Comma-separated list of allowed origins for the frontend (GB). Use "*" only
# for quick local testing without credentials; the SPA sends credentials, so
# set an explicit origin in every real environment.
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=golden_bites
DB_USER=fabianmartinezhoyos
DB_PASSWORD=
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_SSL=false

# JWT (generate strong random secrets for real environments)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
