# Base URL of the Golden Bites API (GB-BE), including its global prefix.
# Relative on purpose: vite.config.ts proxies /api to the backend, so the
# browser always calls same-origin regardless of how the frontend is
# accessed (localhost, LAN IP, or an ngrok tunnel).
VITE_API_BASE_URL=/api/v1

# Hides/shows the "Cobrar con Wompi" checkout button. Leave unset (or 'false') unless
# you're actively testing the sandbox integration — the matching backend flag
# (WOMPI_PAYMENTS_ENABLED) must also be 'true', or the API routes 404 regardless.
VITE_WOMPI_PAYMENTS_ENABLED=false
